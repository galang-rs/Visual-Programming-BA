# EcoSort Environment Configuration (.env.example)

# Port peladen Spring Boot
SERVER_PORT=8080
APP_NAME=ecosort-backend

# Konfigurasi Basis Data (Default H2 File DB)
# Untuk beralih ke PostgreSQL:
# DB_URL=jdbc:postgresql://localhost:5432/ecosortdb
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_password
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_URL=jdbc:h2:file:./data/ecosortdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;AUTO_SERVER=TRUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
JPA_DIALECT=org.hibernate.dialect.H2Dialect
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
H2_CONSOLE_ENABLED=true

# Kunci Rahasia JWT Kriptografis & Masa Berlaku Token (24 jam = 86400000 ms)
JWT_SECRET=9a3f9e6b2c8a1f5d7e3c4b9a0f2e8d1c6b4a7f9e2d5c8a1f4b7e0d3c6a9f2b5e
JWT_EXPIRATION_MS=86400000
